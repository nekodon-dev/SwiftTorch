{
  "schemaVersion": 1,
  "id": "swifttorch",
  "version": "${version}",
  "name": "SwiftTorch",
  "description": "Right-click with a pickaxe while carrying a torch to place the torch automatically.",
  "authors": [
    "nekodon"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/swifttorch",
    "sources": "https://github.com/nekodon-dev/SwiftTorch",
    "issues": "https://github.com/nekodon-dev/SwiftTorch/issues"
  },
  "license": "MIT",
  "icon": "assets/swifttorch/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.nekodon.swifttorch.SwiftTorch"
    ],
    "client": [
      "com.nekodon.swifttorch.SwiftTorchClient"
    ]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
